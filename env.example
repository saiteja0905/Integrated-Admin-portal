# ============================================================================
# Environment Variables for Shidhaan Blue-collar Marketplace
# ============================================================================
# Copy this file to .env and update with your actual values
# 
# For Docker: Most of these are set in docker-compose.yml
# For Local Development: Create backend/.env and frontend/.env

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# MongoDB Connection String
# Local: mongodb://localhost:27017
# Docker: mongodb://admin:password123@mongodb:27017
MONGO_URL=mongodb://localhost:27017

# Database Name
DB_NAME=shidhaan_marketplace

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================

# JWT Secret Key - REQUIRED in production.
# Generate with: openssl rand -hex 32
# If empty (or left as a published example value) the API generates a random secret
# at startup, which logs everyone out on each restart.
JWT_SECRET=

# Session length in minutes (default 30)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================================
# PAYMENT GATEWAY (Razorpay)
# ============================================================================
# Get your keys from: https://dashboard.razorpay.com/

# Razorpay Key ID (starts with rzp_test_ or rzp_live_)
RAZORPAY_KEY_ID=rzp_test_placeholder

# Razorpay Secret Key
RAZORPAY_KEY_SECRET=test_secret_placeholder

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================

# Backend API URL (used by React app)
# Local Dev: http://localhost:8000
# Docker: http://localhost:8000
# Production: https://your-domain.com
REACT_APP_BACKEND_URL=http://localhost:8000

# ============================================================================
# CORS CONFIGURATION
# ============================================================================

# Allowed origins for CORS (comma-separated)
# Include both frontend dev server and production URLs
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost

# ============================================================================
# OPTIONAL: GOOGLE MAPS API
# ============================================================================
# Get your API key from: https://console.cloud.google.com/

GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ============================================================================
# OPTIONAL: EMAIL CONFIGURATION (for OTP)
# ============================================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# ============================================================================
# OPTIONAL: SMS CONFIGURATION (for phone OTP)
# ============================================================================

SMS_API_KEY=your_sms_api_key_here
SMS_SENDER_ID=SHIDHAAN

# ============================================================================
# DEPLOYMENT NOTES
# ============================================================================
# 
# 1. For Docker deployment:
#    - Update docker-compose.yml with production values
#    - Never commit real credentials to git
# 
# 2. For local development:
#    - Backend: Create backend/.env with MongoDB and JWT settings
#    - Frontend: Create frontend/.env with REACT_APP_BACKEND_URL
# 
# 3. Security best practices:
#    - Change JWT_SECRET to a random 32+ character string
#    - Use real Razorpay credentials in production
#    - Enable HTTPS in production
#    - Restrict CORS_ORIGINS to your actual domains
