# Environment Variables for Shidhaan Blue-collar Marketplace
# Copy this file to .env and update with your actual values

# Database Configuration
MONGO_URL=mongodb://localhost:27017
DB_NAME=shidhaan_marketplace

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Razorpay Payment Gateway (Get from https://razorpay.com/)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Frontend Backend URL (for React app)
REACT_APP_BACKEND_URL=http://localhost:8000

# Optional: Google Maps API (for location services)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional: Email Configuration (for OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Optional: SMS Configuration (for phone OTP)
SMS_API_KEY=your_sms_api_key_here
SMS_SENDER_ID=SHIDHAAN
